# Copy this file to .env. Never commit .env.

# Comma-separated list of web origins allowed to call the API. Use * while developing.
ALLOWED_ORIGINS=*

# Optional. Leave these empty and Thamun explains itself with built-in templates.
# Any OpenAI-compatible chat completions endpoint works.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=6
