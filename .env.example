# Copy this file to .env. Never commit .env.

# Comma-separated list of web origins allowed to call the API.
# Use * only while developing. In production set the exact web address, for example https://thamun.vercel.app
ALLOWED_ORIGINS=*

# Signs session tokens and hashes session and reporter ids. Use a long random value and keep it private.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
THAMUN_SECRET=

# Key for the admin routes (raw feedback export and the audit log). Leave empty to switch those routes off.
ADMIN_KEY=

# true: every data route needs a session token from POST /auth/session. Set false only for local experiments.
AUTH_REQUIRED=true

# Requests allowed per minute for one session or one address.
RATE_LIMIT_PER_MINUTE=240

# Database. Leave DATABASE_URL empty to use a local SQLite file (data/thamun.db).
# For PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=
# DATABASE_SSL=true
# THAMUN_DB_PATH=data/thamun.db

# Optional language model for rewording only. It never decides and never sees more than the finished alert text.
# internal_only: the model is used only when LLM_BASE_URL points at a private address or a host listed in
# LLM_INTERNAL_HOSTS, so customer data stays inside the wallet's own network.
# allow_external: also allows a public API. Use this for a demo on synthetic data only.
LLM_DATA_RESIDENCY=internal_only
LLM_INTERNAL_HOSTS=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=http://localhost:11434/v1
LLM_TIMEOUT=6
